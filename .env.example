APP_NAME=isme
APP_PORT=8081
APP_ENV=development
LOGGER_MODE=pretty
LOGGER_LEVEL=debug
GRACEFUL_VERBOSE=false
GRACEFUL_STEP_DELAY=100
GRACEFUL_SERVER_SHUTDOWN_TIMEOUT=20000
# UI API base injected into the SPA (same origin as the embedded server)
VITE_API_BASE_URL=http://sso.isme.local:8081

# Postgres — these match the docker-compose defaults (`make db-up`, host port 5433).
# DB_DSN, when set, overrides the discrete fields.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=isme
# Password left blank on purpose: the local compose default is the same as DB_USER.
DB_PASSWORD=
DB_NAME=isme
DB_SSLMODE=disable
DB_DSN=

AUTH_APP_CODE=isme
AUTH_ENDPOINT_WEB_SSO_LOGIN=/sso/login
AUTH_ENDPOINT_WEB_ACCEPT_INVITE=/accept-invite
# make gen-key-rsa256, then paste each PEM as one line with \n escapes
AUTH_ACCESS_TOKEN_PRIVATE_KEY=
AUTH_ACCESS_TOKEN_PUBLIC_KEY=
# HS256 secret for refresh tokens
AUTH_REFRESH_TOKEN_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_IN=900
AUTH_REFRESH_TOKEN_EXPIRE_IN=86400
AUTH_EXTERNAL_LOGIN_SESSION_TTL=600
AUTH_EXTERNAL_EXCHANGE_CODE_TTL=60

SCHEDULER_ENABLED=true

# Encrypts app_service secrets at rest
AES_SECRET=

# Avatar uploads go through medioa; empty key disables them
MEDIOA_BASE_URL=http://127.0.0.1:8082
MEDIOA_API_KEY=
