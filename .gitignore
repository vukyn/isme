# Git ignore
.env
bin/
todo

# Claude Code (machine-local settings + agent memory)
# Machine-local Claude state. Everything is ignored EXCEPT the repo-root
# agent-memory, which is knowledge about this repo and has to travel with it.
# ⚠️ A .claude/ below the root is a store an agent made because a session's cwd
# was a subdirectory — same knowledge, invisible to the repo's own agent. Those
# stay ignored; consolidate their notes into the root store instead.
**/.claude/
!/.claude/
/.claude/*
!/.claude/agent-memory

# Node
node_modules/

# Python
venv/

# MacOS
.DS_Store

# Certificates
certs/

# code-review-graph cache (local knowledge graph)
.code-review-graph/

# Embedded UI build output — produced by `make build-web` into internal/web/dist.
# The bundle is a build artifact (not committed); the .gitkeep keeps the embed
# directory (and the go:embed pattern) valid on a fresh checkout.
internal/web/dist/*
!internal/web/dist/.gitkeep

# legacy SQLite files — isme no longer uses them; never commit. They hold
# secrets (app_service secrets, session tokens). The db/*.db glob does not match
# the backups subdir, hence the second line.
db/*.db
db/backups/
